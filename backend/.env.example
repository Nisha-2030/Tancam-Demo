APP_NAME=AI-Powered Aspirant Intelligence Engine Backend
APP_ENV=development
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=*

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=aspirant_intelligence_engine

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

NEWS_API_URL=https://newsdata.io/api/1/latest
NEWS_API_KEY=
REQUEST_TIMEOUT_SECONDS=30

CACHE_BACKEND=memory
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_MAX_ITEMS=2000
REDIS_URL=
REDIS_KEY_PREFIX=aie:

CACHE_TTL_NEWS_FETCH_SECONDS=120
CACHE_TTL_NEWS_FILTER_SECONDS=300
CACHE_TTL_NEWS_PIPELINE_SECONDS=180
CACHE_TTL_NOTES_SECONDS=1800
CACHE_TTL_QUIZ_SECONDS=1800
CACHE_TTL_EMBEDDING_SECONDS=86400
CACHE_TTL_CLASSIFICATION_SECONDS=1800

OPENAI_SOURCE_MAX_CHARS=2200
OPENAI_CLASSIFICATION_SNIPPET_CHARS=240
OPENAI_CLASSIFICATION_MAX_TOKENS=500
OPENAI_NOTES_MAX_TOKENS=500
OPENAI_QUIZ_MAX_TOKENS=350

STATIC_GK_EXTERNAL_URL=
STATIC_GK_EXTERNAL_API_KEY=
STATIC_GK_EXTERNAL_AUTH_HEADER=Authorization
STATIC_GK_EXTERNAL_TIMEOUT_SECONDS=20
STATIC_GK_EXTERNAL_VERIFY_SSL=true
